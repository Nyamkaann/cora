# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Public base url of this deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 8: Facebook and Instagram publishing ---

# Encrypts the stored Meta access tokens. 32 bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Meta app -> Settings -> Basic
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business reads permissions from this configuration,
# not from the scope parameter. Not a secret: it travels in the consent url.
META_LOGIN_CONFIG_ID=

# Any random string; Meta echoes it back when verifying the webhook
META_WEBHOOK_VERIFY_TOKEN=

# Protects /api/cron/publish. Any random string:
#   openssl rand -hex 32
CRON_SECRET=
